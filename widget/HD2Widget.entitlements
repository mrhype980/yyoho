<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Widgets must be sandboxed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The one folder the widget may read: the snapshot the app writes (main.js: widgetDir, Sources/Store.swift: fileURL). -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/Helldivers 2 War Tracker/Widget/</string>
	</array>
</dict>
</plist>
